DB_HOST=localhost
DB_PORT=3306
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppass
DATABASE_URL=mysql+pymysql://appuser:apppass@mysql:3306/appdb

OTEL_SERVICE_NAME=miner
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENV=dev
MINER_TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318

MAX_THREADS=10
PROCESSING_TIMEOUT_SECONDS=900
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
MINER_PAGE_ISOLATION_ENABLED=true
MINER_PAGE_HARD_TIMEOUT_SECONDS=45
BROWSER_BACKEND=obscura
OBSCURA_CDP_ENDPOINT=http://localhost:9222
OBSCURA_CDP_CONNECT_TIMEOUT_SECONDS=60

SAVE_HTML=False
MAX_CHARACTERS_TEXT=1000000
PREFLIGHT_ENABLED=true
PREFLIGHT_TIMEOUT_MS=2000
BODY_READY_TIMEOUT_MS=1000
TEXT_FALLBACK_TIMEOUT_MS=1000
HREF_EXTRACTION_TIMEOUT_MS=1000
PLAYWRIGHT_DEFAULT_TIMEOUT_MS=5000
REQUESTER_TOTAL_TIMEOUT_SECONDS=30

